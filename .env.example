# ---- Banco de dados MySQL / MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oticas
DB_PASSWORD=troque-esta-senha
DB_NAME=oticas_montagens

# ---- Aplicação ----
PORT=3000

# Segredo que assina o cookie de sessão.
# GERE UM NOVO com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se este valor mudar, todas as sessões abertas caem e cada um entra de novo.
SESSION_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres

# Duração da sessão em horas
SESSION_HOURS=12

# Deixe em "true" quando o site estiver atrás de HTTPS (o normal em produção).
# Em "false" o cookie também funciona em HTTP, para testar antes do certificado.
COOKIE_SECURE=true

# Se o Node estiver atrás de Nginx/Apache, mantenha em "true"
# para o servidor reconhecer o HTTPS repassado pelo proxy.
TRUST_PROXY=true
